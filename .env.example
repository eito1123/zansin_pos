# Vercel > Project > Settings > Environment Variables (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
POS_AUTH_EMAIL=YOUR_OPERATIONS_ACCOUNT_EMAIL
# 32 cryptographically random bytes encoded as 64 hex characters; not the login password.
POS_COOKIE_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
